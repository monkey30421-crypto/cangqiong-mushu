extends SceneTree

func _initialize() -> void:
	var reaction = load("res://modules/damage_reaction.gd").new()
	assert(not reaction.receive(30, 100, 1.0), "Exactly 30 percent is not a knockdown")
	reaction.advance(4.9)
	assert(reaction.receive(1, 100, 1.0))
	assert(reaction.down_remaining > 0.0)
	reaction.advance(1.0)
	assert(reaction.down_remaining == 0.0)
	reaction.reset()
	assert(not reaction.receive(30, 100, 1.0))
	reaction.advance(5.0)
	assert(not reaction.receive(1, 100, 1.0), "Expired damage cannot trigger knockdown")
	reaction.finish_getup()
	assert(reaction.is_invulnerable())
	assert(not reaction.receive(99, 100, 1.0))
	reaction.advance(1.999)
	assert(reaction.is_invulnerable(), "Recovery protection lasts two seconds")
	reaction.advance(0.0011)
	assert(not reaction.is_invulnerable())
	reaction.finish_getup()
	reaction.reset()
	assert(not reaction.is_invulnerable(), "Scene reset clears protection")
	print("DAMAGE_REACTION_TEST_OK")
	quit()
